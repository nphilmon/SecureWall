<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#F3F4F8</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F6F7FB</Color>
    <Color x:Key="BorderColor">#E2E5EE</Color>
    <Color x:Key="TextColor">#171B2E</Color>
    <Color x:Key="MutedColor">#667085</Color>
    <Color x:Key="AccentColor">#2F6BFF</Color>
    <Color x:Key="AccentHoverColor">#1F55D8</Color>
    <Color x:Key="AccentSoftColor">#E6EEFF</Color>
    <Color x:Key="GoodColor">#12935B</Color>
    <Color x:Key="GoodSoftColor">#E3F6EC</Color>
    <Color x:Key="WarnColor">#B76E00</Color>
    <Color x:Key="WarnSoftColor">#FFF1D6</Color>
    <Color x:Key="BadColor">#D92D20</Color>
    <Color x:Key="BadSoftColor">#FDE7E5</Color>
    <Color x:Key="InfoColor">#2F6BFF</Color>
    <Color x:Key="InfoSoftColor">#E6EEFF</Color>
    <Color x:Key="NeutralSoftColor">#EEF0F5</Color>
    <Color x:Key="SidebarColor">#EDEFF6</Color>
    <Color x:Key="HoverColor">#E9ECF5</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}"/>
    <SolidColorBrush x:Key="GoodSoftBrush" Color="{StaticResource GoodSoftColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnSoftColor}"/>
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}"/>
    <SolidColorBrush x:Key="BadSoftBrush" Color="{StaticResource BadSoftColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="{StaticResource NeutralSoftColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="White"/>
</ResourceDictionary>
