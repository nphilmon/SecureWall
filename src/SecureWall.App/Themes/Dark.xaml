<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#14161F</Color>
    <Color x:Key="SurfaceColor">#1D202C</Color>
    <Color x:Key="SurfaceAltColor">#232736</Color>
    <Color x:Key="BorderColor">#32374A</Color>
    <Color x:Key="TextColor">#EDEFF7</Color>
    <Color x:Key="MutedColor">#9AA3B8</Color>
    <Color x:Key="AccentColor">#6B96FF</Color>
    <Color x:Key="AccentHoverColor">#86A9FF</Color>
    <Color x:Key="AccentSoftColor">#26335A</Color>
    <Color x:Key="GoodColor">#3DD598</Color>
    <Color x:Key="GoodSoftColor">#173A2E</Color>
    <Color x:Key="WarnColor">#F5B544</Color>
    <Color x:Key="WarnSoftColor">#40321A</Color>
    <Color x:Key="BadColor">#FF6B61</Color>
    <Color x:Key="BadSoftColor">#42211F</Color>
    <Color x:Key="InfoColor">#6B96FF</Color>
    <Color x:Key="InfoSoftColor">#26335A</Color>
    <Color x:Key="NeutralSoftColor">#2A2E3D</Color>
    <Color x:Key="SidebarColor">#191B26</Color>
    <Color x:Key="HoverColor">#2B3042</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}"/>
    <SolidColorBrush x:Key="GoodSoftBrush" Color="{StaticResource GoodSoftColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnSoftColor}"/>
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}"/>
    <SolidColorBrush x:Key="BadSoftBrush" Color="{StaticResource BadSoftColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="{StaticResource NeutralSoftColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0B1020"/>
</ResourceDictionary>
