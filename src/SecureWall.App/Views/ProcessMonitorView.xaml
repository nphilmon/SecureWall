<UserControl x:Class="SecureWall.App.Views.ProcessMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SecureWall.App.Controls"
             Style="{StaticResource PageStyle}">
    <Grid Margin="28,6,28,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ctl:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}">
            <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
        </ctl:PageHeader>
        <ctl:MessageBar Grid.Row="1" Text="{Binding Message}" Level="{Binding MessageLevel}"/>
        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBox Tag="Rechercher un processus" DockPanel.Dock="Left" Width="280" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rechercher un processus" ToolTip="Nom, chemin, éditeur ou PID"/>
            <CheckBox Content="Avec connexions réseau" IsChecked="{Binding OnlyNetwork}" Margin="18,0,0,0"/>
            <CheckBox Content="Non signés ou inconnus (informatif)" IsChecked="{Binding OnlyUnsigned}" Margin="18,0,0,0"/>
        </DockPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10" IsEnabled="{Binding Selected, Converter={StaticResource NotNullToBool}}">
            <Button Content="Analyser le programme" Command="{Binding AnalyzeCommand}" CommandParameter="{Binding Selected}" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Analyse antivirus" Command="{Binding ScanFileCommand}" CommandParameter="{Binding Selected}"/>
            <Button Content="Afficher le fichier" Command="{Binding OpenLocationCommand}" CommandParameter="{Binding Selected}"/>
            <Button Content="Connexions" Command="{Binding ShowConnectionsCommand}" CommandParameter="{Binding Selected}"/>
            <Button Content="Propriétés" Command="{Binding PropertiesCommand}" CommandParameter="{Binding Selected}"/>
        </StackPanel>
        <DataGrid Grid.Row="4" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Liste des processus">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Nom" Width="190" MinWidth="190" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" MinWidth="70"/>
                <DataGridTextColumn Header="Utilisateur" Binding="{Binding User}" Width="150" MinWidth="150" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Éditeur" Binding="{Binding Publisher}" Width="170" MinWidth="170" ElementStyle="{StaticResource CellText}"/>
                <DataGridTemplateColumn Header="Signature" Width="130" MinWidth="130" SortMemberPath="SignatureText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding SignatureText}" Foreground="{Binding SignatureLevel, Converter={StaticResource LevelFg}}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="CPU" Binding="{Binding Cpu, StringFormat={}{0:0.0} %}" Width="70" MinWidth="70"/>
                <DataGridTextColumn Header="RAM (Mo)" Binding="{Binding MemoryMb, StringFormat={}{0:N0}}" Width="90" MinWidth="90"/>
                <DataGridTextColumn Header="Réseau" Binding="{Binding Connections}" Width="70" MinWidth="70"/>
                <DataGridTextColumn Header="Lancé le" Binding="{Binding StartText}" Width="140" MinWidth="140"/>
                <DataGridTextColumn Header="Faits relevés" Binding="{Binding Indicators}" Width="200" MinWidth="200" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Chemin" Binding="{Binding Path}" Width="*" MinWidth="180" ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
