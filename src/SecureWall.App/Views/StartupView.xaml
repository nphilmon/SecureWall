<UserControl x:Class="SecureWall.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SecureWall.App.Controls"
             Style="{StaticResource PageStyle}">
    <Grid Margin="28,6,28,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ctl:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}">
            <Button Content="Actualiser" Command="{Binding RefreshCommand}" Margin="0"/>
        </ctl:PageHeader>
        <ctl:MessageBar Grid.Row="1" Text="{Binding Message}" Level="{Binding MessageLevel}"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10" IsEnabled="{Binding Selected, Converter={StaticResource NotNullToBool}}">
            <Button Content="Analyser" Command="{Binding AnalyzeCommand}" CommandParameter="{Binding Selected}" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Ouvrir l'emplacement" Command="{Binding OpenLocationCommand}" CommandParameter="{Binding Selected}"/>
            <Button Content="Propriétés" Command="{Binding PropertiesCommand}" CommandParameter="{Binding Selected}"/>
            <Button Content="Activer / Désactiver…" Command="{Binding ToggleCommand}" CommandParameter="{Binding Selected}"/>
        </StackPanel>
        <DataGrid Grid.Row="3" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Programmes au démarrage">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Programme" Binding="{Binding Name}" Width="190" MinWidth="190" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Éditeur" Binding="{Binding Publisher}" Width="170" MinWidth="170" ElementStyle="{StaticResource CellText}"/>
                <DataGridTemplateColumn Header="Signature" Width="130" MinWidth="130" SortMemberPath="Signature.Text">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding Signature.Text}" Foreground="{Binding Signature.Level, Converter={StaticResource LevelFg}}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="90" MinWidth="90"/>
                <DataGridTextColumn Header="Impact" Binding="{Binding Impact}" Width="180" MinWidth="180" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Emplacement du démarrage" Binding="{Binding Location}" Width="2*" MinWidth="180" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Chemin" Binding="{Binding Path}" Width="3*" MinWidth="180" ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
