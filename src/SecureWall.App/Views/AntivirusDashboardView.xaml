<UserControl x:Class="SecureWall.App.Views.AntivirusDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SecureWall.App.Controls"
             Style="{StaticResource PageStyle}">
    <Grid Margin="28,6,28,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ctl:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Actualiser" Command="{Binding RefreshCommand}"/>
                <Button Content="Ouvrir Windows Security" Command="{Binding OpenWindowsSecurityCommand}" Margin="0"/>
            </StackPanel>
        </ctl:PageHeader>
        <ctl:MessageBar Grid.Row="1" Text="{Binding Message}" Level="{Binding MessageLevel}"/>

        <TabControl Grid.Row="2">
            <TabItem Header="Protection en temps réel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,24">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DefenderStatusText}" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="Ces protections sont fournies et gérées par Microsoft Defender. SecureWall n'ajoute aucune protection de fichiers de son côté : ce que vous voyez ici est l'état réel signalé par Windows."/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <ctl:StatusBadge Text="{Binding SignatureAgeText}" Level="{Binding SignatureLevel}"/>
                                        <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <Run Text="Signatures "/><Run Text="{Binding Signature.Version, Mode=OneWay}"/><Run Text=" · moteur "/><Run Text="{Binding Signature.EngineVersion, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="Rechercher les mises à jour" Command="{Binding UpdateCommand}" IsEnabled="{Binding Updating, Converter={StaticResource InvBool}}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/>
                                    <Button Content="Lancer une analyse" Command="{Binding GoToScansCommand}" Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Features}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"><Run Text="Géré par "/><Run Text="{Binding ManagedBy, Mode=OneWay}"/></TextBlock>
                                            </StackPanel>
                                            <ctl:StatusBadge Grid.Column="1" Text="{Binding StateText}" Level="{Binding Level}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Modifier ces protections dans Windows Security" Command="{Binding OpenProtectionSettingsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Exclusions">
                <StackPanel Margin="0,0,0,12">
                    <ctl:MessageBar Text="Une exclusion réduit la protection antivirus pour les éléments concernés. SecureWall ne crée jamais d'exclusion automatiquement." Level="Warning"/>
                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Text="Windows ne communique les exclusions qu'aux comptes administrateurs : lancez SecureWall en administrateur pour les voir (SecureWall ne les modifie pas)."
                                       Visibility="{Binding ExclusionsVisible, Converter={StaticResource InvBoolToVis}}"/>
                            <TextBlock Style="{StaticResource Muted}" Text="Aucune exclusion configurée."
                                       Visibility="{Binding ExclusionsVisible, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding Exclusions}">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Gérer dans Windows Security" Command="{Binding OpenProtectionSettingsCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
