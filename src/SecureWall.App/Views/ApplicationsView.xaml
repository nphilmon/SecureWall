<UserControl x:Class="SecureWall.App.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SecureWall.App.Controls"
             Style="{StaticResource PageStyle}">
    <Grid Margin="28,6,28,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ctl:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}">
            <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
        </ctl:PageHeader>
        <ctl:MessageBar Grid.Row="1" Text="{Binding Message}" Level="{Binding MessageLevel}"/>
        <TextBox Tag="Rechercher une application" Grid.Row="2" HorizontalAlignment="Left" Width="320" Margin="0,0,0,10" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rechercher une application" ToolTip="Nom, chemin ou éditeur"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10" IsEnabled="{Binding Selected, Converter={StaticResource NotNullToBool}}">
            <Button Content="Autoriser" Command="{Binding AllowCommand}" CommandParameter="{Binding Selected}"/>
            <Button Content="Bloquer" Command="{Binding BlockCommand}" CommandParameter="{Binding Selected}" Style="{StaticResource DangerButton}"/>
            <Button Content="Créer une règle…" Command="{Binding CreateRuleCommand}" CommandParameter="{Binding Selected}"/>
            <Button Content="Voir les connexions" Command="{Binding ShowConnectionsCommand}" CommandParameter="{Binding Selected}"/>
            <Button Content="Analyser avec Defender" Command="{Binding AnalyzeCommand}" CommandParameter="{Binding Selected}" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Ouvrir l'emplacement" Command="{Binding OpenLocationCommand}" CommandParameter="{Binding Selected}"/>
        </StackPanel>
        <Grid Grid.Row="4">
            <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Applications ayant utilisé le réseau">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Application" Width="200" MinWidth="200" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Éditeur" Binding="{Binding Publisher}" Width="170" MinWidth="170" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTemplateColumn Header="Signature" Width="130" MinWidth="130" SortMemberPath="SignatureText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding SignatureText}" Foreground="{Binding SignatureLevel, Converter={StaticResource LevelFg}}"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Active" Binding="{Binding Connections}" Width="65" MinWidth="65"/>
                    <DataGridTemplateColumn Header="Règle actuelle" Width="230" MinWidth="230" SortMemberPath="CurrentRule">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding CurrentRule}" TextTrimming="CharacterEllipsis" Foreground="{Binding RuleLevel, Converter={StaticResource LevelFg}}"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Première détection" Binding="{Binding FirstSeenText}" SortMemberPath="FirstSeen" Width="145" MinWidth="145"/>
                    <DataGridTextColumn Header="Dernière connexion" Binding="{Binding LastSeenText}" SortMemberPath="LastSeen" Width="145" MinWidth="145"/>
                    <DataGridTextColumn Header="Chemin" Binding="{Binding Path}" Width="*" MinWidth="180" ElementStyle="{StaticResource CellText}"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Items.Count, Converter={StaticResource EmptyToVis}}" MaxWidth="460">
                <TextBlock Text="Aucune application enregistrée pour le moment" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                <TextBlock Text="Les programmes apparaissent ici dès qu'ils établissent une connexion vers l'extérieur. SecureWall observe les connexions ; il n'intercepte aucun contenu." Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
