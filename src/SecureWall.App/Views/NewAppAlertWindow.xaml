<Window x:Class="SecureWall.App.Views.NewAppAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvelle application réseau" Width="560" SizeToContent="Height" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <StackPanel Margin="26,22,26,20">
        <StackPanel Orientation="Horizontal">
            <Image x:Name="AppIcon" Width="40" Height="40" Margin="0,0,14,0"/>
            <StackPanel>
                <TextBlock Text="Une nouvelle application accède au réseau" Style="{StaticResource H2}"/>
                <TextBlock x:Name="NameText" FontSize="18" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="Éditeur" Style="{StaticResource Muted}" Margin="0,3,16,3"/>
                <TextBlock x:Name="PublisherText" Grid.Column="1" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Text="Signature" Style="{StaticResource Muted}" Margin="0,3,16,3"/>
                <TextBlock x:Name="SignatureText" Grid.Row="1" Grid.Column="1"/>
                <TextBlock Grid.Row="2" Text="Chemin" Style="{StaticResource Muted}" Margin="0,3,16,3"/>
                <TextBlock x:Name="PathText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="3" Text="Destination" Style="{StaticResource Muted}" Margin="0,3,16,3"/>
                <TextBlock x:Name="DestinationText" Grid.Row="3" Grid.Column="1"/>
                <TextBlock Grid.Row="4" Text="Port" Style="{StaticResource Muted}" Margin="0,3,16,3"/>
                <TextBlock x:Name="PortText" Grid.Row="4" Grid.Column="1"/>
                <TextBlock Grid.Row="5" Text="Protocole" Style="{StaticResource Muted}" Margin="0,3,16,3"/>
                <TextBlock x:Name="ProtocolText" Grid.Row="5" Grid.Column="1"/>
            </Grid>
        </Border>
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                   Text="Cette information est factuelle : une application nouvelle sur le réseau n'est pas forcément dangereuse. « Une fois » = jusqu'à la fermeture de SecureWall."/>
        <UniformGrid Columns="2">
            <Button Content="Autoriser une fois" Click="OnAllowOnce" Margin="0,0,8,8"/>
            <Button Content="Toujours autoriser" Click="OnAlwaysAllow" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/>
            <Button Content="Bloquer une fois" Click="OnBlockOnce" Margin="0,0,8,0"/>
            <Button Content="Toujours bloquer" Click="OnAlwaysBlock" Style="{StaticResource DangerButton}" Margin="0"/>
        </UniformGrid>
    </StackPanel>
</Window>
