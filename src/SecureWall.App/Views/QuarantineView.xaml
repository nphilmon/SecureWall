<UserControl x:Class="SecureWall.App.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SecureWall.App.Controls"
             Style="{StaticResource PageStyle}">
    <Grid Margin="28,6,28,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ctl:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Actualiser" Command="{Binding RefreshCommand}" Margin="0"/>
            </StackPanel>
        </ctl:PageHeader>
        <ctl:MessageBar Grid.Row="1" Text="{Binding Message}" Level="{Binding MessageLevel}"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10" IsEnabled="{Binding Selected, Converter={StaticResource NotNullToBool}}">
            <Button Content="Afficher les détails" Command="{Binding DetailsCommand}" CommandParameter="{Binding Selected}"/>
            <Button Content="Restaurer…" Command="{Binding RestoreCommand}" CommandParameter="{Binding Selected}" Style="{StaticResource DangerButton}"/>
            <Button Content="Supprimer définitivement…" Command="{Binding DeleteCommand}" CommandParameter="{Binding Selected}"/>
        </StackPanel>
        <Grid Grid.Row="3">
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Éléments en quarantaine">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Menace" Binding="{Binding Name}" Width="2*" MinWidth="220" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Fichier" Binding="{Binding FileName}" Width="*" MinWidth="150" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Chemin" Binding="{Binding FilePath}" Width="3*" MinWidth="280" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding DetectionDateText}" Width="140" MinWidth="140" SortMemberPath="DetectionTime"/>
                    <DataGridTemplateColumn Header="Gravité" Width="100" MinWidth="100" SortMemberPath="SeverityId">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ctl:StatusBadge Text="{Binding Severity}" Level="{Binding SeverityLevel}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="140" MinWidth="140"/>
                    <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="140" MinWidth="140"/>
                    <DataGridTextColumn Header="Moteur" Binding="{Binding Engine}" Width="150" MinWidth="150"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Items.Count, Converter={StaticResource EmptyToVis}}">
                <TextBlock Text="La quarantaine est vide" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                <TextBlock Text="Aucun élément n'est actuellement isolé par Microsoft Defender." Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
