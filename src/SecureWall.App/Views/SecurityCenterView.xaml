<UserControl x:Class="SecureWall.App.Views.SecurityCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SecureWall.App.Controls"
             Style="{StaticResource PageStyle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,6,16,24">
            <ctl:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Actualiser" Command="{Binding RefreshCommand}"/>
                    <Button Content="Windows Security" Command="{Binding OpenWindowsSecurityCommand}" Margin="0"/>
                </StackPanel>
            </ctl:PageHeader>
            <ctl:MessageBar Text="{Binding Message}" Level="{Binding MessageLevel}"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12" BorderBrush="{Binding Summary.StateLevel, Converter={StaticResource LevelFg}}" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="État global" Style="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding Summary.StateText}" Style="{StaticResource H1}" Foreground="{Binding Summary.StateLevel, Converter={StaticResource LevelFg}}"/>
                    <ItemsControl ItemsSource="{Binding Reasons}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <ctl:StatusBadge DockPanel.Dock="Right" Text="{Binding StatusText}" Level="{Binding Level}"/>
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,10,0" Foreground="{Binding Level, Converter={StaticResource LevelFg}}"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Lines}" Margin="0,10,0,10">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="{Binding ActionText}" HorizontalAlignment="Left" Margin="0"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
