<UserControl x:Class="SecureWall.App.Views.FirewallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SecureWall.App.Controls"
             xmlns:vm="clr-namespace:SecureWall.App.ViewModels"
             Style="{StaticResource PageStyle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,6,16,24">
            <ctl:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Gérer les règles" Command="{Binding GoToRulesCommand}"/>
                    <Button Content="Actualiser" Command="{Binding RefreshCommand}"/>
                    <Button Content="Windows Defender Firewall" Command="{Binding OpenWindowsFirewallCommand}" Margin="0"/>
                </StackPanel>
            </ctl:PageHeader>
            <ctl:MessageBar Text="{Binding Message}" Level="{Binding MessageLevel}"/>

            <TextBlock Text="Profils réseau" Style="{StaticResource H2}" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <ctl:StatusBadge DockPanel.Dock="Right" Text="Profil actif" Level="Info" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2}"/>
                                </DockPanel>
                                <TextBlock Margin="0,10,0,0" FontSize="20" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Text" Value="Désactivé"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                    <Setter Property="Text" Value="Activé"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,10"><Run Text="Entrant : "/><Run Text="{Binding DefaultInbound, Mode=OneWay}"/><Run Text=" par défaut · Sortant : "/><Run Text="{Binding DefaultOutbound, Mode=OneWay}"/></TextBlock>
                                <Button Content="Activer / désactiver…" HorizontalAlignment="Left" Margin="0"
                                        Command="{Binding DataContext.ToggleProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        IsEnabled="{Binding DataContext.ServiceAvailable, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Réseaux détectés" Style="{StaticResource H2}"/>
                        <TextBlock Text="Aucun réseau actif." Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding Networks.Count, Converter={StaticResource EmptyToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Networks}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock FontWeight="SemiBold"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Category, Mode=OneWay}"/></TextBlock>
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Interface, Mode=OneWay}"/><Run Text=" — "/><Run Text="{Binding Connectivity, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Connexions bloquées" Style="{StaticResource H2}"/>
                        <ctl:MessageBar Text="{Binding AuditText}" Level="{Binding AuditLevel}" Margin="0,8,0,0"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Windows n'enregistre les connexions refusées que si l'audit « Plateforme de filtrage » est activé. SecureWall ne l'active jamais sans votre accord."/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Activer l'audit…" Command="{Binding EnableAuditCommand}" IsEnabled="{Binding ServiceAvailable}"/>
                            <Button Content="Désactiver l'audit" Command="{Binding DisableAuditCommand}" IsEnabled="{Binding ServiceAvailable}" Margin="0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Alertes et confirmations" Style="{StaticResource H2}"/>
                        <CheckBox Content="Me prévenir lorsqu'une nouvelle application accède au réseau" IsChecked="{Binding AlertNewApps}" Margin="0,10,0,0"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="46,0,0,6" Text="Détection après la première connexion observée. Les composants critiques de Windows ne sont jamais bloqués."/>
                        <CheckBox Content="Demander confirmation avant de modifier une règle" IsChecked="{Binding ConfirmRules}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sauvegardes du pare-feu" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8" Text="Une sauvegarde est créée automatiquement avant chaque modification importante."/>
                        <ComboBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" HorizontalAlignment="Stretch" Margin="0,0,0,8" AutomationProperties.Name="Sauvegardes disponibles"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Créer une sauvegarde" Command="{Binding BackupCommand}" IsEnabled="{Binding ServiceAvailable}"/>
                            <Button Content="Restaurer…" Command="{Binding RestoreBackupCommand}" IsEnabled="{Binding ServiceAvailable}" Margin="0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0" BorderBrush="{DynamicResource BadBrush}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Mode urgence" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Text="Coupe tout le trafic entre ce PC et Internet via deux règles du pare-feu Windows (le réseau local reste disponible). L'état précédent est sauvegardé et « Restaurer Internet » supprime ces règles."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="230">
                        <TextBlock Text="Rétablissement automatique" Style="{StaticResource Muted}" Margin="0,0,0,4"
                                   Visibility="{Binding EmergencyActive, Converter={StaticResource InvBoolToVis}}"/>
                        <ComboBox ItemsSource="{x:Static vm:FirewallViewModel.AutoRestoreLabels}" SelectedIndex="{Binding AutoRestoreIndex, Mode=TwoWay}" Margin="0,0,0,8"
                                  Visibility="{Binding EmergencyActive, Converter={StaticResource InvBoolToVis}}" AutomationProperties.Name="Rétablissement automatique d'Internet"/>
                        <TextBlock Text="{Binding EmergencyCountdown}" TextWrapping="Wrap" Margin="0,0,0,8" MaxWidth="260"
                                   Visibility="{Binding EmergencyActive, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Couper Internet…" Command="{Binding CutoffCommand}" Style="{StaticResource DangerButton}" IsEnabled="{Binding ServiceAvailable}"
                                Visibility="{Binding EmergencyActive, Converter={StaticResource InvBoolToVis}}" Margin="0"/>
                        <Button Content="Restaurer Internet" Command="{Binding RestoreInternetCommand}" Style="{StaticResource PrimaryButton}"
                                Visibility="{Binding EmergencyActive, Converter={StaticResource BoolToVis}}" Margin="0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
