<Window x:Class="SecureWall.App.Views.ProgramAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SecureWall.App.Controls"
        Title="Analyse du programme" Width="760" Height="700" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,22,26,22">
            <TextBlock Text="{Binding Name}" Style="{StaticResource H1}"/>
            <TextBlock Text="{Binding Path}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
            <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                <TextBlock Text="{Binding BusyText}"/>
                <ProgressBar IsIndeterminate="True" Margin="0,8,0,0"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,16,0,12">
                <StackPanel>
                    <TextBlock Text="Résultat antivirus" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding DefenderText}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{Binding DefenderLevel, Converter={StaticResource LevelFg}}"/>
                    <ItemsControl ItemsSource="{Binding Detections}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{Binding Level, Converter={StaticResource LevelFg}}"/>
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Signature numérique" Style="{StaticResource H2}"/>
                    <ctl:StatusBadge Text="{Binding Signature.Text}" Level="{Binding Signature.Level}" Margin="0,8,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="Éditeur" Style="{StaticResource Muted}" Margin="0,3,16,3"/>
                        <TextBlock Grid.Column="1" Text="{Binding Signature.Publisher}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Text="Empreinte" Style="{StaticResource Muted}" Margin="0,3,16,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Signature.Thumbprint}" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" Text="La signature numérique ne sert jamais seule à décider qu'un logiciel est malveillant."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Informations inhabituelles (ce ne sont pas des détections)" Style="{StaticResource H2}"/>
                    <ItemsControl ItemsSource="{Binding Informations}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,5">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{Binding Level, Converter={StaticResource LevelFg}}"/>
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Connexions réseau actuelles" Style="{StaticResource H2}"/>
                    <TextBlock Text="Aucune connexion active pour ce programme." Style="{StaticResource Muted}" Margin="0,6,0,0" Visibility="{Binding Connections.Count, Converter={StaticResource EmptyToVis}}"/>
                    <DataGrid ItemsSource="{Binding Connections}" MaxHeight="220" Margin="0,8,0,0" Visibility="{Binding Connections.Count, Converter={StaticResource CountToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Proto." Binding="{Binding Protocol}" Width="65" MinWidth="65"/>
                            <DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="*" MinWidth="180"/>
                            <DataGridTextColumn Header="Destination" Binding="{Binding Remote}" Width="*" MinWidth="180"/>
                            <DataGridTextColumn Header="Port" Binding="{Binding RemotePort}" Width="70" MinWidth="70"/>
                            <DataGridTextColumn Header="État" Binding="{Binding State}" Width="100" MinWidth="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Règles de pare-feu associées" Style="{StaticResource H2}"/>
                    <TextBlock Text="Aucune règle ne cible spécifiquement ce programme." Style="{StaticResource Muted}" Margin="0,6,0,0" Visibility="{Binding Rules.Count, Converter={StaticResource EmptyToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Rules}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,3"><Run Text="{Binding ActionText, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding DirectionText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding StatusText, Mode=OneWay}"/></TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Button Content="Fermer" IsCancel="True" HorizontalAlignment="Right" Margin="0" Click="OnClose"/>
        </StackPanel>
    </ScrollViewer>
</Window>
