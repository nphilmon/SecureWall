<UserControl x:Class="SecureWall.App.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SecureWall.App.Controls"
             Style="{StaticResource PageStyle}">
    <Grid Margin="28,6,28,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ctl:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}">
            <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
        </ctl:PageHeader>
        <ctl:MessageBar Grid.Row="1" Text="{Binding Message}" Level="{Binding MessageLevel}"/>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,10">
            <StackPanel>
                <WrapPanel>
                    <TextBox Tag="Filtrer par application" Width="170" Text="{Binding AppFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,6" ToolTip="Application" AutomationProperties.Name="Filtrer par application"/>
                    <ComboBox ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding Protocol}" Width="90" Margin="0,0,8,6" AutomationProperties.Name="Protocole"/>
                    <TextBox Tag="Filtrer par port" Width="90" Text="{Binding PortFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,6" ToolTip="Port local ou distant" AutomationProperties.Name="Filtrer par port"/>
                    <TextBox Tag="Filtrer par adresse IP" Width="150" Text="{Binding IpFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,6" ToolTip="Adresse IP" AutomationProperties.Name="Filtrer par adresse IP"/>
                    <ComboBox ItemsSource="{Binding StateOptions}" SelectedItem="{Binding StateFilter}" Width="130" Margin="0,0,8,6" AutomationProperties.Name="État"/>
                    <CheckBox Content="Masquer le trafic local" IsChecked="{Binding HideLocal}" Margin="10,2,12,6"/>
                    <CheckBox Content="Masquer l'écoute" IsChecked="{Binding HideListening}" Margin="0,2,12,6"/>
                    <Button Content="✕ Filtre PID" Command="{Binding ClearPidCommand}" Visibility="{Binding PidFilter, Converter={StaticResource NotNullToVis}}" Margin="0,0,0,6"/>
                </WrapPanel>
                <TextBlock Text="Filtres : application, protocole, port, IP et état. Les adresses « externes » excluent le réseau local, la boucle locale et les plages privées." Style="{StaticResource Muted}" FontSize="11"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10" IsEnabled="{Binding Selected, Converter={StaticResource NotNullToBool}}">
            <Button Content="Analyser le programme" Command="{Binding AnalyzeCommand}" CommandParameter="{Binding Selected}"/>
            <Button Content="Ouvrir l'emplacement" Command="{Binding OpenLocationCommand}" CommandParameter="{Binding Selected}"/>
            <Button Content="Copier l'IP distante" Command="{Binding CopyRemoteCommand}" CommandParameter="{Binding Selected}"/>
        </StackPanel>

        <DataGrid Grid.Row="4" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Connexions réseau">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Application" Width="190" MinWidth="190" SortMemberPath="ProcessName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="75" MinWidth="75"/>
                <DataGridTextColumn Header="Proto." Binding="{Binding Protocol}" Width="80" MinWidth="80"/>
                <DataGridTextColumn Header="IP locale" Binding="{Binding Local}" Width="190" MinWidth="190" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="IP distante" Binding="{Binding Remote}" Width="210" MinWidth="210" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="État" Binding="{Binding State}" Width="110" MinWidth="110"/>
                <DataGridTextColumn Header="Portée" Binding="{Binding Scope}" Width="90" MinWidth="90"/>
                <DataGridTextColumn Header="Envoyé" Binding="{Binding Sent}" Width="100" MinWidth="100"/>
                <DataGridTextColumn Header="Reçu" Binding="{Binding Received}" Width="100" MinWidth="100"/>
                <DataGridTextColumn Header="Chemin" Binding="{Binding ProcessPath}" Width="*" MinWidth="200" ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
