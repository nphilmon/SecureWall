<Window x:Class="SecureWall.App.Views.RuleWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SecureWall.App.Controls"
        xmlns:vm="clr-namespace:SecureWall.App.ViewModels"
        xmlns:local="clr-namespace:SecureWall.App.Views"
        Title="Assistant de règle de pare-feu" Width="640" Height="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Window.Resources><local:StepVisibilityConverter x:Key="StepVis"/></Window.Resources>
    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Progress}" Style="{StaticResource Muted}"/>
            <TextBlock Text="{Binding StepTitle}" Style="{StaticResource H1}" Margin="0,2,0,0"/>
            <ProgressBar Margin="0,10,0,14" Minimum="0" Maximum="8" Value="{Binding Step}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
            <Grid>
                <!-- 1. Type -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=0}">
                    <TextBlock Text="Que souhaitez-vous contrôler ?" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <RadioButton Content="Un programme (autoriser ou bloquer une application)" IsChecked="{Binding TypeProgram}" GroupName="t"/>
                    <RadioButton Content="Un port (par exemple 3389 ou 8080)" IsChecked="{Binding TypePort}" GroupName="t"/>
                    <RadioButton Content="Personnalisée (tous critères combinés)" IsChecked="{Binding TypeCustom}" GroupName="t"/>
                    <TextBlock Text="Direction du trafic" Style="{StaticResource H2}" Margin="0,16,0,8"/>
                    <RadioButton Content="Sortant (le PC se connecte à l'extérieur)" IsChecked="{Binding Inbound, Converter={StaticResource InvBool}}" GroupName="d"/>
                    <RadioButton Content="Entrant (l'extérieur se connecte au PC)" IsChecked="{Binding Inbound}" GroupName="d"/>
                </StackPanel>
                <!-- 2. Application -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=1}">
                    <TextBlock Text="Programme concerné" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Parcourir…" Click="OnBrowse" Margin="8,0,0,0"/>
                        <TextBox Tag="Chemin du programme" Text="{Binding Program, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Chemin du programme"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Chemin complet d'un exécutable (.exe). Laissez vide pour que la règle s'applique à tous les programmes."/>
                </StackPanel>
                <!-- 3. Protocole -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=2}">
                    <TextBlock Text="Protocole" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{x:Static vm:RuleWizardViewModel.Protocols}" SelectedItem="{Binding Protocol}" ItemTemplate="{StaticResource EnumItem}" HorizontalAlignment="Left" Width="200" AutomationProperties.Name="Protocole"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="« Any » applique la règle à tous les protocoles. TCP et UDP permettent de restreindre les ports."/>
                </StackPanel>
                <!-- 4. Ports -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=3}">
                    <TextBlock Text="Ports" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBlock Style="{StaticResource Muted}" Text="Les ports ne sont disponibles qu'avec TCP ou UDP." Visibility="{Binding PortsAvailable, Converter={StaticResource InvBoolToVis}}"/>
                    <StackPanel IsEnabled="{Binding PortsAvailable}">
                        <TextBlock Text="Port local" Margin="0,0,0,4"/>
                        <TextBox Tag="Port local" Text="{Binding LocalPorts, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Port local"/>
                        <TextBlock Text="Port distant" Margin="0,10,0,4"/>
                        <TextBox Tag="Port distant" Text="{Binding RemotePorts, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Port distant"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Laissez vide pour tous les ports. Exemples : 443 · 80,443 · 8000-8100."/>
                    </StackPanel>
                </StackPanel>
                <!-- 5. IP -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=4}">
                    <TextBlock Text="Adresses IP" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBlock Text="IP locale" Margin="0,0,0,4"/>
                    <TextBox Tag="Adresse IP locale" Text="{Binding LocalAddresses, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Adresse IP locale"/>
                    <TextBlock Text="IP distante" Margin="0,10,0,4"/>
                    <TextBox Tag="Adresse IP distante" Text="{Binding RemoteAddresses, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Adresse IP distante"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Laissez vide pour toutes les adresses. Exemples : 192.168.1.10 · 10.0.0.0/8 · 1.2.3.4-1.2.3.9 · Internet · LocalSubnet."/>
                </StackPanel>
                <!-- 6. Action -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=5}">
                    <TextBlock Text="Action" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <RadioButton Content="Autoriser la connexion" IsChecked="{Binding Allow}" GroupName="a"/>
                    <RadioButton Content="Bloquer la connexion" IsChecked="{Binding Allow, Converter={StaticResource InvBool}}" GroupName="a"/>
                    <CheckBox Content="Activer la règle dès sa création" IsChecked="{Binding Enabled}" Margin="0,14,0,0"/>
                </StackPanel>
                <!-- 7. Profil -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=6}">
                    <TextBlock Text="Profils réseau concernés" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <CheckBox Content="Domaine" IsChecked="{Binding Domain}"/>
                    <CheckBox Content="Privé" IsChecked="{Binding Private}"/>
                    <CheckBox Content="Public" IsChecked="{Binding Public}"/>
                </StackPanel>
                <!-- 8. Nom -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=7}">
                    <TextBlock Text="Nom de la règle" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBox Tag="Nom de la règle" Text="{Binding RuleName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nom de la règle"/>
                    <TextBlock Text="Description (facultative)" Margin="0,12,0,4"/>
                    <TextBox Tag="Description" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="Description"/>
                </StackPanel>
                <!-- 9. Confirmation -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=8}">
                    <TextBlock Text="Vérifiez la règle avant de la créer" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="14">
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" LineHeight="22"/>
                    </Border>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="Une sauvegarde du pare-feu sera créée avant l'ajout. L'opération est effectuée par le service privilégié SecureWall."/>
                </StackPanel>
            </Grid>
        </Border>

        <ctl:MessageBar Grid.Row="2" Level="Bad" Text="{Binding Error}" Margin="0,12,0,0"/>

        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Annuler" IsCancel="True" Margin="0"/>
            <Button DockPanel.Dock="Right" Content="Créer la règle" Click="OnFinish" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Visibility="{Binding IsLast, Converter={StaticResource BoolToVis}}"/>
            <Button DockPanel.Dock="Right" Content="Suivant" Command="{Binding NextCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Visibility="{Binding IsLast, Converter={StaticResource InvBoolToVis}}" IsDefault="True"/>
            <Button DockPanel.Dock="Right" Content="Retour" Command="{Binding BackCommand}" IsEnabled="{Binding CanBack}" Margin="0"/>
        </DockPanel>
    </Grid>
</Window>
