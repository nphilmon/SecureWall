<Window x:Class="SecureWall.App.Views.BaselineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SecureWall.App.Controls"
        Title="Règles de base du pare-feu" Width="760" Height="680" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}"/>
            <TextBlock Text="{Binding SourceText}" Style="{StaticResource Muted}" FontSize="11"/>
            <TextBlock Text="{Binding AppliedText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,10">
            <StackPanel>
                <TextBlock Text="Mise à jour du jeu de règles (facultatif)" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,6" Text="Rien n'est téléchargé sans votre clic. Seules les adresses HTTPS de raw.githubusercontent.com sont acceptées, et le fichier n'est utilisé que si sa signature numérique correspond à la clé de l'éditeur de SecureWall."/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Rechercher une mise à jour" Command="{Binding CheckUpdateCommand}" IsEnabled="{Binding Busy, Converter={StaticResource InvBool}}" Margin="8,0,0,0"/>
                    <TextBox Text="{Binding UpdateUrl, UpdateSourceTrigger=PropertyChanged}" Tag="https://raw.githubusercontent.com/…/baseline-rules.signed.json" AutomationProperties.Name="Adresse du jeu de règles"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,2,12,0" AutomationProperties.Name="{Binding Name}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ctl:StatusBadge Grid.Column="2" Text="{Binding StatusText}" Level="{Binding StatusLevel}" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ctl:MessageBar Grid.Row="3" Text="{Binding Message}" Level="{Binding MessageLevel}" Margin="0,10,0,0"/>
        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Fermer" IsCancel="True" Margin="0"/>
            <Button DockPanel.Dock="Right" Content="Ajouter les règles cochées…" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding Busy, Converter={StaticResource InvBool}}" Margin="0"/>
        </DockPanel>
    </Grid>
</Window>
